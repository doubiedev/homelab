$TTL 2d

$ORIGIN doubie.dev.

@                       IN      SOA     ns.doubie.dev. info.doubie.dev. (
                                        2025060304  ; serial
                                        12h         ; refresh
                                        15m         ; retry
                                        3w          ; expire
                                        2h          ; minimum ttl
                                        )

                        IN      NS      ns.doubie.dev.

ns                      IN      A       192.168.2.1

; -- VPS Services
@                       IN      A       103.108.228.248
netbird                 IN      A       103.108.228.248

; -- Infrastructure
pve-1                   IN      A       192.168.1.1
pve-2                   IN      A       192.168.1.2
srv-1                   IN      A       192.168.2.1
srv-2                   IN      A       192.168.2.2

; -- Home Services
*                       IN      A       192.168.2.1

; Clients
y370                    IN      A       192.168.0.10
mbox                    IN      A       192.168.0.11
omarchy                 IN      A       192.168.0.12
