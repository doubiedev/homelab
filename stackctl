#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/.stackctl"

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

DEFAULT_SERVER=""

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
Usage:
  $0 <command> <stack> [server]

Commands:
  start       Deploy a stack
  stop        Stop/remove a stack
  restart     Restart a stack
  status      Show stack services
  ps          Show stack tasks
  logs        Show stack logs
  list        List available servers and stacks
  set-server  Set the default server

Examples:
  $0 start portainer
  $0 start portainer srv-2
  $0 stop portainer
  $0 restart portainer
  $0 status portainer
  $0 ps portainer
  $0 logs portainer
  $0 list
  $0 set-server srv-1
EOF
    exit 1
}

stack_exists() {
    docker stack ls --format '{{.Name}}' | grep -qx "$STACK"
}

require_server() {
    if [[ -n "$SERVER" ]]; then
        return
    fi

    echo "Error: no server specified and no default server is configured."
    echo
    echo "Set a default server with:"
    echo "  $0 set-server srv-1"
    echo
    echo "Or specify a server explicitly:"
    echo "  $0 $COMMAND $STACK srv-1"
    exit 1
}

validate_server() {
    local server="$1"
    local server_dir="$SCRIPT_DIR/$server"

    if [[ ! "$server" =~ ^srv-[0-9]+$ ]]; then
        echo "Error: invalid server name '$server'."
        echo
        echo "Server names must follow the format:"
        echo "  srv-<number>"
        echo
        echo "Examples:"
        echo "  srv-1"
        echo "  srv-2"
        echo "  srv-10"
        exit 1
    fi

    if [[ ! -d "$server_dir" ]]; then
        echo "Error: server '$server' does not exist."
        echo
        echo "Expected server directory:"
        echo "  $server_dir"
        exit 1
    fi
}
# ---------------------------------------------------------------------------
# Stack operations
# ---------------------------------------------------------------------------

deploy_stack() {
    require_server
    validate_server "$SERVER"

    local stack_dir="$SCRIPT_DIR/$SERVER/$STACK"
    local compose_file="$stack_dir/swarm.yml"

    if [[ ! -d "$stack_dir" ]]; then
        echo "Error: stack directory does not exist:"
        echo "  $stack_dir"
        exit 1
    fi

    if [[ ! -f "$compose_file" ]]; then
        echo "Error: compose file not found:"
        echo "  $compose_file"
        exit 1
    fi

    echo "Deploying '$STACK' on '$SERVER'..."

    docker stack deploy \
        -c "$compose_file" \
        "$STACK"
}

remove_stack() {
    if ! stack_exists; then
        echo "Stack '$STACK' does not exist."
        return
    fi

    echo "Removing stack '$STACK'..."

    docker stack rm "$STACK"

    echo "Waiting for stack to be removed..."

    while stack_exists; do
        sleep 1
    done
}

set_default_server() {
    local server="$1"

    validate_server "$server"

    cat > "$CONFIG_FILE" <<EOF
DEFAULT_SERVER="$server"
EOF

    echo "Default server set to '$server'."
    echo "Configuration saved to:"
    echo "  $CONFIG_FILE"
}

get_stack_status() {
    local stack="$1"

    if ! docker stack ls --format '{{.Name}}' | grep -qx "$stack"; then
        echo "DOWN"
        return
    fi

    local services
    services="$(docker stack services "$stack" --format '{{.Replicas}}')"

    if [[ -z "$services" ]]; then
        echo "DOWN"
        return
    fi

    local replicas
    local current
    local desired

    while IFS= read -r replicas; do
        current="${replicas%%/*}"
        desired="${replicas##*/}"

        if [[ "$current" != "$desired" ]]; then
            echo "DEGRADED"
            return
        fi
    done <<< "$services"

    echo "UP"
}

list_stacks() {
    local server="$1"
    local server_dir="$SCRIPT_DIR/$server"

    echo "Server: $server"

    if [[ "$server" == "$DEFAULT_SERVER" ]]; then
        echo "  (default)"
    fi

    local found=false

    while IFS= read -r stack_dir; do
        found=true

        local stack
        local status

        stack="$(basename "$stack_dir")"
        status="$(get_stack_status "$stack")"

        printf "  %-20s %s\n" "$stack" "$status"
    done < <(
        find "$server_dir" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -print |
        sort
    )

    if [[ "$found" == false ]]; then
        echo "  (no stacks)"
    fi

    echo
}

list_all() {
    local found=false

    echo "Available servers:"
    echo

    while IFS= read -r server_dir; do
        found=true
        list_stacks "$(basename "$server_dir")"
    done < <(
        find "$SCRIPT_DIR" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -print |
        while IFS= read -r dir; do
            server="$(basename "$dir")"

            if [[ "$server" =~ ^srv-[0-9]+$ ]]; then
                printf '%s\n' "$dir"
            fi
        done |
        sort -V
    )

    if [[ "$found" == false ]]; then
        echo "  No server directories found."
    fi
}

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

[[ $# -ge 1 ]] || usage

COMMAND="$1"

# ---------------------------------------------------------------------------
# Commands without a stack argument
# ---------------------------------------------------------------------------

case "$COMMAND" in

    list)
        [[ $# -eq 1 ]] || {
            echo "Usage:"
            echo "  $0 list"
            exit 1
        }

        list_all
        exit 0
        ;;

    set-server)
        [[ $# -eq 2 ]] || {
            echo "Usage:"
            echo "  $0 set-server <server>"
            exit 1
        }

        set_default_server "$2"
        exit 0
        ;;

esac

# All remaining commands require a stack argument.
[[ $# -ge 2 ]] || usage

STACK="$2"
SERVER="${3:-$DEFAULT_SERVER}"

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

case "$COMMAND" in

    start)
        deploy_stack
        ;;

    stop)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        remove_stack
        ;;

    restart)
        require_server
        validate_server "$SERVER"

        if stack_exists; then
            remove_stack
        else
            echo "Stack '$STACK' is not currently running."
        fi

        deploy_stack
        ;;

    status)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        docker stack services "$STACK"
        ;;

    ps)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        docker stack ps "$STACK"
        ;;

    logs)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        docker stack services "$STACK" \
            --format '{{.Name}}' |
        while read -r service; do
            echo
            echo "============================================================"
            echo "$service"
            echo "============================================================"

            docker service logs \
                --tail 100 \
                "$service"
        done
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo
        usage
        ;;

esac
