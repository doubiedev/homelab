#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICES_DIR="$SCRIPT_DIR/services"

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# Directories inside services/ that should not be treated as stacks.
# Add directory names here as needed.
IGNORED_DIRS=(
    ".git"
    "_deprecated"
)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

usage() {
    cat <<EOF
Usage:
  $0 <command> <stack>

Commands:
  start       Deploy a stack
  stop        Stop/remove a stack
  restart     Restart a stack
  status      Show stack services
  ps          Show stack tasks
  logs        Show stack logs
  list        List available stacks

Examples:
  $0 start portainer
  $0 stop portainer
  $0 restart portainer
  $0 status portainer
  $0 ps portainer
  $0 logs portainer
  $0 list
EOF
    exit 1
}

stack_exists() {
    docker stack ls --format '{{.Name}}' | grep -qx "$STACK"
}

validate_stack() {
    local stack="$1"
    local stack_dir="$SERVICES_DIR/$stack"
    local compose_file="$stack_dir/swarm.yml"

    if [[ ! "$stack" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]]; then
        echo "Error: invalid stack name '$stack'."
        exit 1
    fi

    if [[ ! -d "$stack_dir" ]]; then
        echo "Error: stack '$stack' does not exist."
        echo
        echo "Expected stack directory:"
        echo "  $stack_dir"
        exit 1
    fi

    if [[ ! -f "$compose_file" ]]; then
        echo "Error: compose file not found:"
        echo "  $compose_file"
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Stack operations
# ---------------------------------------------------------------------------

deploy_stack() {
    validate_stack "$STACK"

    local stack_dir="$SERVICES_DIR/$STACK"
    local compose_file="$stack_dir/swarm.yml"

    echo "Deploying '$STACK'..."

    docker stack deploy \
        -c "$compose_file" \
        "$STACK"
}

remove_stack() {
    if ! stack_exists; then
        echo "Stack '$STACK' does not exist."
        return
    fi

    local network="${STACK}_default"

    echo "Removing stack '$STACK'..."

    docker stack rm "$STACK"

    echo "Waiting for stack to be removed..."

    while stack_exists; do
        sleep 1
    done

    echo "Waiting for network '$network' to be removed..."

    while docker network inspect "$network" >/dev/null 2>&1; do
        sleep 1
    done

    echo "Stack '$STACK' has been removed."
}

get_stack_status() {
    local stack="$1"

    if ! docker stack ls --format '{{.Name}}' | grep -qx "$stack"; then
        echo "DOWN"
        return
    fi

    local services
    services="$(docker stack services "$stack" --format '{{.Replicas}}')"

    if [[ -z "$services" ]]; then
        echo "DOWN"
        return
    fi

    local replicas
    local current
    local desired

    while IFS= read -r replicas; do
        current="${replicas%%/*}"
        desired="${replicas##*/}"

        if [[ "$current" != "$desired" ]]; then
            echo "DEGRADED"
            return
        fi
    done <<< "$services"

    echo "UP"
}

list_stacks() {
    local found=false
    local stack_dir
    local stack
    local status
    local ignored
    local dir_name
    local ignored_dir

    echo "Available stacks:"
    echo

    while IFS= read -r stack_dir; do
        dir_name="$(basename "$stack_dir")"
        ignored=false

        for ignored_dir in "${IGNORED_DIRS[@]}"; do
            if [[ "$dir_name" == "$ignored_dir" ]]; then
                ignored=true
                break
            fi
        done

        [[ "$ignored" == true ]] && continue

        found=true

        stack="$dir_name"
        status="$(get_stack_status "$stack")"

        printf "  %-20s %s\n" "$stack" "$status"
    done < <(
        find "$SERVICES_DIR" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -print |
        sort
    )

    if [[ "$found" == false ]]; then
        echo "  (no stacks)"
    fi
}

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------

[[ $# -ge 1 ]] || usage

COMMAND="$1"

# ---------------------------------------------------------------------------
# Commands without a stack argument
# ---------------------------------------------------------------------------

case "$COMMAND" in

    list)
        [[ $# -eq 1 ]] || {
            echo "Usage:"
            echo "  $0 list"
            exit 1
        }

        list_stacks
        exit 0
        ;;

esac

# All remaining commands require a stack argument.
[[ $# -eq 2 ]] || usage

STACK="$2"

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

case "$COMMAND" in

    start)
        deploy_stack
        ;;

    stop)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        remove_stack
        ;;

    restart)
        validate_stack "$STACK"

        if stack_exists; then
            remove_stack
        else
            echo "Stack '$STACK' is not currently running."
        fi

        deploy_stack
        ;;

    status)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        docker stack services "$STACK"
        ;;

    ps)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        docker stack ps "$STACK"
        ;;

    logs)
        if ! stack_exists; then
            echo "Error: stack '$STACK' does not exist."
            exit 1
        fi

        docker stack services "$STACK" \
            --format '{{.Name}}' |
        while read -r service; do
            echo
            echo "============================================================"
            echo "$service"
            echo "============================================================"

            docker service logs \
                --tail 100 \
                "$service"
        done
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo
        usage
        ;;

esac
